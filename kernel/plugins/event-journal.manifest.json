{
  "manifest_version": 1,
  "plugin": {
    "id": "org.vibe.event.journal",
    "version": "0.9.0"
  },
  "runtime": {
    "protocol": "vibe-plugin/1",
    "executable": "bin/event-journal",
    "isolation": "process",
    "data_namespace": "state-authority/journal-main"
  },
  "exports": [
    {
      "capability": "event.journal.append",
      "major": 1,
      "contract": "event.journal.append@1",
      "mode": "stateful",
      "service": "default-event-journal",
      "authority": "journal-main",
      "priority": 100
    },
    {
      "capability": "event.journal.replay",
      "major": 1,
      "contract": "event.journal.replay@1",
      "mode": "stateful",
      "service": "default-event-journal",
      "authority": "journal-main",
      "priority": 100
    }
  ],
  "restart": {
    "mode": "on_failure",
    "max_attempts": 2,
    "cooldown_ms": 100
  },
  "resources": {
    "memory_mb": 128,
    "cpu_weight": 20
  }
}

{
  "manifest_version": 1,
  "plugin": { "id": "org.vibe.<NAME>", "version": "1.0.0" },
  "runtime": {
    "protocol": "vibe-plugin/1",
    "executable": "../bin/<NAME>",
    "isolation": "process",
    "data_namespace": "state-authority/<AUTHORITY>"
  },
  "exports": [
    { "capability": "<capability>", "major": 1, "contract": "<capability>@1", "mode": "stateless", "priority": 100 }
  ],
  "consumes": {
    "required": [
      { "capability": "blob.put", "major": 1, "contract": "blob.put@1" }
    ]
  },
  "restart": { "mode": "on_failure", "max_attempts": 2, "cooldown_ms": 200 },
  "resources": { "memory_mb": 128, "cpu_weight": 20 }
}
